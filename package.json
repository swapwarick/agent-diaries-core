{
  "name": "@agent-diaries/core",
  "version": "2.3.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swapwarick/agent-diaries-core.git"
  },
  "description": "Stop your AI agents from doing the same work twice. Exactly-once execution, deduplication, and distributed coordination for multi-agent systems.",
  "keywords": [
    "ai-agent",
    "agent-memory",
    "workflow-orchestration",
    "deduplication",
    "distributed-lock",
    "state-machine",
    "redis",
    "mongodb",
    "serverless",
    "idempotency",
    "task-queue"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./diary": {
      "types": "./dist/diary.d.ts",
      "import": "./dist/diary.mjs",
      "require": "./dist/diary.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.mjs",
      "require": "./dist/storage.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.mjs",
      "require": "./dist/core/index.js"
    },
    "./memory": {
      "types": "./dist/memory/index.d.ts",
      "import": "./dist/memory/index.mjs",
      "require": "./dist/memory/index.js"
    },
    "./redis": {
      "types": "./dist/redis/index.d.ts",
      "import": "./dist/redis/index.mjs",
      "require": "./dist/redis/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres/index.d.ts",
      "import": "./dist/postgres/index.mjs",
      "require": "./dist/postgres/index.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.mjs",
      "require": "./dist/shared/index.js"
    },
    "./adapters/*": {
      "types": "./dist/adapters/*.d.ts",
      "import": "./dist/adapters/*.mjs",
      "require": "./dist/adapters/*.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.mjs",
      "require": "./dist/tools/index.js"
    },
    "./agents": {
      "types": "./dist/agents/index.d.ts",
      "import": "./dist/agents/index.mjs",
      "require": "./dist/agents/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.mjs",
      "require": "./dist/runtime/index.js"
    },
    "./runtime/distributed": {
      "types": "./dist/runtime/distributed/contracts.d.ts",
      "import": "./dist/runtime/distributed/contracts.mjs",
      "require": "./dist/runtime/distributed/contracts.js"
    },
    "./langchain": {
      "types": "./dist/langchain/index.d.ts",
      "import": "./dist/langchain/index.mjs",
      "require": "./dist/langchain/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.reporter=lcov --coverage.reporter=text",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "docs:generate": "typedoc",
    "build": "tsup",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major"
  },
  "author": "swapwarick_n",
  "bugs": {
    "url": "https://github.com/swapwarick/agent-diaries-core/issues"
  },
  "homepage": "https://github.com/swapwarick/agent-diaries-core#readme",
  "license": "MIT",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "@types/proper-lockfile": "^4.1.4",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitest/coverage-v8": "^4.1.7",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "ioredis": "^5.10.1",
    "mongodb": "^7.2.0",
    "pg": "^8.22.0",
    "postcss": "^8.5.25",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.9",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "proper-lockfile": "^4.1.2",
    "lru-cache": "^10.2.0",
    "msgpack-lite": "^0.1.26",
    "prom-client": "^15.1.0"
  },
  "peerDependencies": {
    "better-sqlite3": ">=9 || >=10 || >=11",
    "ioredis": ">=5",
    "mongodb": ">=6",
    "pg": ">=8"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "mongodb": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}